<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>EntityAPIAnalyzer</AssemblyName>
    <RootNamespace>EntityAPIAnalyzer</RootNamespace>
    <!-- RS2007/RS2008: analyzer release tracking is intentionally disabled for this project. -->
    <NoWarn>$(NoWarn);RS2007;RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Workspaces reference is required for the CodeFixProvider.
         ExcludeAssets="runtime" prevents bundling the workspace assemblies;
         Roslyn provides them at runtime. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.3.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <!-- Optional: copy the analyzer/generator DLL to a Unity plugin folder.
       Disabled by default. To deploy, provide the destination folder:
         dotnet build ... -p:AtomicDeployToUnity=true -p:AtomicUnityPluginDir=C:\YourProject\Assets\Plugins\Atomic\SourceGenerators
  -->
  <Target Name="CopyToUnity" AfterTargets="Build" Condition="'$(AtomicDeployToUnity)' == 'true' And '$(AtomicUnityPluginDir)' != ''">
    <Copy SourceFiles="$(TargetDir)$(TargetName).dll" DestinationFolder="$([MSBuild]::NormalizeDirectory('$(AtomicUnityPluginDir)'))" SkipUnchangedFiles="true" />
    <Message Text="$(TargetName) deployed to $(AtomicUnityPluginDir)" Importance="high" />
  </Target>

</Project>
